{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "QuanLyTaiKhoanAPI",
    "Audience": "QuanLyTaiKhoanClient",
    "AccessTokenExpirationHours": "3",
    "RefreshTokenExpirationDays": "7"
  },
  "Identity": {
    "PasswordResetTokenMinutes": 15,
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutMinutes": 15
    }
  },
  "App": {
    "ClientUrl": "https://YOUR_DOMAIN"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "YOUR_EMAIL",
    "Password": "",
    "FromEmail": "YOUR_EMAIL",
    "FromName": "Quan Ly Tai Khoan"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://YOUR_DOMAIN"
    ]
  },
  "BootstrapAdmin": {
    "Enabled": false,
    "UserName": "",
    "Email": "",
    "Password": "",
    "FullName": "Administrator"
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowMinutes": 1
    },
    "PasswordReset": {
      "PermitLimit": 3,
      "WindowMinutes": 15
    }
  },
  "RefreshTokenCleanup": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "RetentionDays": 30
  },
  "EnableHttpsRedirection": true,
  "Database": {
    "ApplyMigrationsOnStartup": false
  }
}
