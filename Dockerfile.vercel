FROM node:22-bookworm-slim AS frontend
WORKDIR /src/UI
COPY UI/package.json UI/package-lock.json ./
RUN npm ci
COPY UI/ ./
RUN npm run build

FROM mcr.microsoft.com/dotnet/sdk:8.0-bookworm-slim AS backend
WORKDIR /src
COPY API/QuanLyTaiKhoanAPI/QuanLyTaiKhoanAPI.csproj API/QuanLyTaiKhoanAPI/
RUN dotnet restore API/QuanLyTaiKhoanAPI/QuanLyTaiKhoanAPI.csproj
COPY API/QuanLyTaiKhoanAPI/ API/QuanLyTaiKhoanAPI/
RUN dotnet publish API/QuanLyTaiKhoanAPI/QuanLyTaiKhoanAPI.csproj \
    -c Release --no-restore -o /out /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0-bookworm-slim
WORKDIR /app
ENV ASPNETCORE_ENVIRONMENT=Production PORT=8080
COPY --from=backend /out/ ./
COPY --from=frontend /src/UI/dist/ ./wwwroot/
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "ASPNETCORE_URLS=http://0.0.0.0:${PORT:-8080} exec dotnet QuanLyTaiKhoanAPI.dll"]
